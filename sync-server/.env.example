# The domain name pointing at this server. Caddy gets its HTTPS certificate.
SYNC_DOMAIN=sync.example.com
# Optional but recommended: only devices that know this key can use the server. Generate one with: openssl rand -base64 24
SYNC_ACCESS_KEY=
# Limits (defaults shown)
SYNC_MAX_RECORD_MB=25
SYNC_SPACE_QUOTA_MB=512
SYNC_HISTORY_DAYS=30
SYNC_DELETION_DAYS=30
