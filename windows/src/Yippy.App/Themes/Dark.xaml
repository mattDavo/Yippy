<!-- Cairn's dark theme colours. ThemeManager swaps this dictionary when the Windows app theme changes.
     The accent is Ember 400, with dark text on it; links use the lighter Ember 300.
     Generated by brand/generate.py from brand/tokens.json. Edit the tokens, not this file. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="Yippy.PanelBackground" Color="#1C1A18" />
    <SolidColorBrush x:Key="Yippy.PanelBorder" Color="#3A3531" />
    <SolidColorBrush x:Key="Yippy.CardBackground" Color="#252220" />
    <SolidColorBrush x:Key="Yippy.CardBorder" Color="#34302C" />
    <SolidColorBrush x:Key="Yippy.CardHover" Color="#2C2926" />
    <SolidColorBrush x:Key="Yippy.CardSelected" Color="#3A2A22" />
    <SolidColorBrush x:Key="Yippy.Divider" Color="#34302C" />

    <!-- Text -->
    <SolidColorBrush x:Key="Yippy.PrimaryText" Color="#F5F1EB" />
    <SolidColorBrush x:Key="Yippy.SecondaryText" Color="#B5ADA3" />
    <SolidColorBrush x:Key="Yippy.DisabledText" Color="#6F675E" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Yippy.Accent" Color="#EE875A" />
    <SolidColorBrush x:Key="Yippy.AccentHover" Color="#F29A73" />
    <SolidColorBrush x:Key="Yippy.AccentPressed" Color="#E07447" />
    <SolidColorBrush x:Key="Yippy.TextOnAccent" Color="#2A1206" />
    <SolidColorBrush x:Key="Yippy.Link" Color="#F4A27E" />

    <!-- Controls -->
    <SolidColorBrush x:Key="Yippy.ControlFill" Color="#2A2724" />
    <SolidColorBrush x:Key="Yippy.ControlFillHover" Color="#322E2B" />
    <SolidColorBrush x:Key="Yippy.ControlFillPressed" Color="#24211F" />
    <SolidColorBrush x:Key="Yippy.ControlBorder" Color="#46403A" />
    <SolidColorBrush x:Key="Yippy.SubtleHover" Color="#10F5F1EB" />
    <SolidColorBrush x:Key="Yippy.SubtlePressed" Color="#0AF5F1EB" />
    <SolidColorBrush x:Key="Yippy.SubtleSelected" Color="#18F5F1EB" />
    <SolidColorBrush x:Key="Yippy.InputBackground" Color="#2A2724" />
    <SolidColorBrush x:Key="Yippy.InputBorder" Color="#4E4740" />
    <SolidColorBrush x:Key="Yippy.SegmentBackground" Color="#2A2724" />
    <SolidColorBrush x:Key="Yippy.SegmentSelected" Color="#46403A" />
    <SolidColorBrush x:Key="Yippy.ToggleOffBorder" Color="#A39B90" />
    <SolidColorBrush x:Key="Yippy.ScrollThumb" Color="#5E574F" />

    <!-- Keycaps: the panel's Ctrl+number hints and the shortcuts list -->
    <SolidColorBrush x:Key="Yippy.KeycapBackground" Color="#2E2A26" />
    <SolidColorBrush x:Key="Yippy.KeycapBorder" Color="#4E4740" />

    <!-- Status -->
    <SolidColorBrush x:Key="Yippy.Favourite" Color="#FF8FA3" />
    <SolidColorBrush x:Key="Yippy.Danger" Color="#FF8A80" />
    <SolidColorBrush x:Key="Yippy.Success" Color="#7CC98E" />
</ResourceDictionary>
