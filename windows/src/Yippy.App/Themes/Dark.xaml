<!-- The Dark theme's colours. ThemeManager swaps this dictionary when the Windows app theme changes. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Yippy.PanelBackground" Color="#202020" />
    <SolidColorBrush x:Key="Yippy.PanelBorder" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Yippy.CardBackground" Color="#2B2B2B" />
    <SolidColorBrush x:Key="Yippy.CardBorder" Color="#383838" />
    <SolidColorBrush x:Key="Yippy.CardHover" Color="#323232" />
    <SolidColorBrush x:Key="Yippy.Accent" Color="#60CDFF" />
    <SolidColorBrush x:Key="Yippy.PrimaryText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Yippy.SecondaryText" Color="#ABABAB" />
    <SolidColorBrush x:Key="Yippy.InputBackground" Color="#2D2D2D" />
    <SolidColorBrush x:Key="Yippy.InputBorder" Color="#454545" />
    <SolidColorBrush x:Key="Yippy.SegmentBackground" Color="#2D2D2D" />
    <SolidColorBrush x:Key="Yippy.SegmentSelected" Color="#454545" />
    <SolidColorBrush x:Key="Yippy.Link" Color="#60CDFF" />
    <SolidColorBrush x:Key="Yippy.Favourite" Color="#FF99A4" />
    <SolidColorBrush x:Key="Yippy.ScrollThumb" Color="#5C5C5C" />
</ResourceDictionary>
