<!-- The Dark theme's colours. ThemeManager swaps this dictionary when the Windows app theme changes.
     The accent is the bright cyan of Yippy's icon (7.9:1 on the panel), with dark text on it. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="Yippy.PanelBackground" Color="#202020" />
    <SolidColorBrush x:Key="Yippy.PanelBorder" Color="#3D3D3D" />
    <SolidColorBrush x:Key="Yippy.CardBackground" Color="#2B2B2B" />
    <SolidColorBrush x:Key="Yippy.CardBorder" Color="#363636" />
    <SolidColorBrush x:Key="Yippy.CardHover" Color="#323232" />
    <SolidColorBrush x:Key="Yippy.CardSelected" Color="#22343D" />
    <SolidColorBrush x:Key="Yippy.Divider" Color="#333333" />

    <!-- Text -->
    <SolidColorBrush x:Key="Yippy.PrimaryText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Yippy.SecondaryText" Color="#B0B0B0" />
    <SolidColorBrush x:Key="Yippy.DisabledText" Color="#6E6E6E" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Yippy.Accent" Color="#4CC2E8" />
    <SolidColorBrush x:Key="Yippy.AccentHover" Color="#45B1D4" />
    <SolidColorBrush x:Key="Yippy.AccentPressed" Color="#3FA0C0" />
    <SolidColorBrush x:Key="Yippy.TextOnAccent" Color="#06212C" />
    <SolidColorBrush x:Key="Yippy.Link" Color="#4CC2E8" />

    <!-- Controls -->
    <SolidColorBrush x:Key="Yippy.ControlFill" Color="#2D2D2D" />
    <SolidColorBrush x:Key="Yippy.ControlFillHover" Color="#323232" />
    <SolidColorBrush x:Key="Yippy.ControlFillPressed" Color="#272727" />
    <SolidColorBrush x:Key="Yippy.ControlBorder" Color="#424242" />
    <SolidColorBrush x:Key="Yippy.SubtleHover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Yippy.SubtlePressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Yippy.SubtleSelected" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Yippy.InputBackground" Color="#2D2D2D" />
    <SolidColorBrush x:Key="Yippy.InputBorder" Color="#4A4A4A" />
    <SolidColorBrush x:Key="Yippy.SegmentBackground" Color="#2D2D2D" />
    <SolidColorBrush x:Key="Yippy.SegmentSelected" Color="#454545" />
    <SolidColorBrush x:Key="Yippy.ToggleOffBorder" Color="#9A9A9A" />
    <SolidColorBrush x:Key="Yippy.ScrollThumb" Color="#5C5C5C" />

    <!-- Keycaps: the panel's Ctrl+number hints and the shortcuts list -->
    <SolidColorBrush x:Key="Yippy.KeycapBackground" Color="#333333" />
    <SolidColorBrush x:Key="Yippy.KeycapBorder" Color="#505050" />

    <!-- Status -->
    <SolidColorBrush x:Key="Yippy.Favourite" Color="#FF99A4" />
    <SolidColorBrush x:Key="Yippy.Danger" Color="#FF99A4" />
    <SolidColorBrush x:Key="Yippy.Success" Color="#6CCB5F" />
</ResourceDictionary>
