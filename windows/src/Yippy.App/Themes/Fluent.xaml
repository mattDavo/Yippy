<!--
    Yippy's design system: type, focus, buttons, toggles, inputs, menus and settings cards in the Windows 11 (Fluent)
    style, with every colour taken from the theme dictionaries (Light.xaml, Dark.xaml) so both themes stay in step.
    Styles keyed "Yippy.*" are applied explicitly; the unkeyed ones restyle every control of that type.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:presentation="clr-namespace:Yippy.App.Presentation">

    <!-- Type: Segoe UI Variable on Windows 11, Segoe UI on Windows 10 -->
    <FontFamily x:Key="Yippy.UIFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Yippy.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Yippy.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Yippy.MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <Style x:Key="Yippy.TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Yippy.DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Yippy.PrimaryText}" />
    </Style>

    <Style x:Key="Yippy.SubtitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Yippy.DisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Yippy.PrimaryText}" />
    </Style>

    <Style x:Key="Yippy.BodyStrongText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Yippy.PrimaryText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Yippy.BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Yippy.PrimaryText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Yippy.CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Yippy.SecondaryText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A heading above a group of settings cards -->
    <Style x:Key="Yippy.SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Yippy.BodyStrongText}">
        <Setter Property="Margin" Value="2,20,0,8" />
    </Style>

    <!-- The border a borderless window draws around itself; WindowStyling sets it to 0 where Windows 11 draws one -->
    <Thickness x:Key="Yippy.FrameThickness">1</Thickness>

    <!-- The keyboard focus ring: a rounded rectangle just outside the control -->
    <Style x:Key="Yippy.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="6" RadiusY="6" StrokeThickness="2"
                               Stroke="{DynamicResource Yippy.PrimaryText}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons -->
    <Style x:Key="Yippy.Button" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Yippy.UIFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Yippy.PrimaryText}" />
        <Setter Property="Background" Value="{DynamicResource Yippy.ControlFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Yippy.ControlBorder}" />
        <Setter Property="Padding" Value="12,5,12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Yippy.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Yippy.ControlFillHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Yippy.ControlFillPressed}" />
                            <Setter Property="Foreground" Value="{DynamicResource Yippy.SecondaryText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Yippy.DisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one main action of a dialog or card -->
    <Style x:Key="Yippy.AccentButton" TargetType="Button" BasedOn="{StaticResource Yippy.Button}">
        <Setter Property="Foreground" Value="{DynamicResource Yippy.TextOnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Yippy.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Yippy.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Yippy.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Yippy.AccentPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Yippy.ControlFillPressed}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Yippy.ControlBorder}" />
                            <Setter Property="Foreground" Value="{DynamicResource Yippy.DisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- For actions that delete something -->
    <Style x:Key="Yippy.DangerButton" TargetType="Button" BasedOn="{StaticResource Yippy.Button}">
        <Setter Property="Foreground" Value="{DynamicResource Yippy.Danger}" />
    </Style>

    <!-- A borderless button showing an icon glyph -->
    <Style x:Key="Yippy.IconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Yippy.IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Yippy.SecondaryText}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Yippy.SubtleHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Yippy.PrimaryText}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Yippy.SubtlePressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource Yippy.Link}" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A switch for settings that are on or off (a CheckBox underneath, so keyboards and screen readers know it) -->
    <Style x:Key="Yippy.ToggleSwitch" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Yippy.UIFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Yippy.PrimaryText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Yippy.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <TextBlock x:Name="State" Text="Off" MinWidth="28" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" TextAlignment="Right" />
                        <Grid Width="40" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                    Background="{DynamicResource Yippy.ControlFill}" BorderBrush="{DynamicResource Yippy.ToggleOffBorder}" />
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource Yippy.SecondaryText}" />
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="14" />
                            <Setter TargetName="Knob" Property="Height" Value="14" />
                            <Setter TargetName="Knob" Property="Margin" Value="3,0" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="State" Property="Text" Value="On" />
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Yippy.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Yippy.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Yippy.TextOnAccent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text boxes: a thin border with an accent underline while typing -->
    <Style x:Key="Yippy.TextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Yippy.UIFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Yippy.PrimaryText}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Yippy.PrimaryText}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Yippy.Accent}" />
        <Setter Property="Padding" Value="10,5,10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Field" Background="{DynamicResource Yippy.InputBackground}"
                                BorderBrush="{DynamicResource Yippy.InputBorder}" BorderThickness="1" CornerRadius="4" />
                        <Border x:Name="Underline" BorderBrush="{DynamicResource Yippy.Accent}" BorderThickness="0,0,0,2"
                                CornerRadius="4" Visibility="Hidden" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Padding="0"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Yippy.ToggleOffBorder}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Yippy.DisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scroll bars: thin, and only vertical (lists wrap rather than scroll sideways) -->
    <Style x:Key="Yippy.ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource Yippy.ScrollThumb}" CornerRadius="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Yippy.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Yippy.ScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,2">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Yippy.ScrollPage}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Yippy.ScrollThumbStyle}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Yippy.ScrollPage}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource Yippy.ScrollBar}" />

    <!-- Drop-down lists -->
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Yippy.UIFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Yippy.PrimaryText}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Yippy.FocusVisual}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome" Background="{DynamicResource Yippy.ControlFill}"
                                            BorderBrush="{DynamicResource Yippy.ControlBorder}" BorderThickness="1" CornerRadius="4">
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Yippy.IconFont}" FontSize="10"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource Yippy.SecondaryText}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Yippy.ControlFillHover}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Yippy.ControlFillPressed}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="12,0,34,1" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border MinWidth="{Binding ActualWidth, ElementName=Toggle}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource Yippy.CardBackground}" BorderBrush="{DynamicResource Yippy.PanelBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="4">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Yippy.DisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row in a list: highlighted on hover, and marked with an accent pill when selected (combo boxes, settings lists) -->
    <Style x:Key="Yippy.ListItem" TargetType="{x:Type Control}">
        <Setter Property="Foreground" Value="{DynamicResource Yippy.PrimaryText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource Yippy.UIFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Yippy.FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <ControlTemplate x:Key="Yippy.ListItemTemplate" TargetType="{x:Type ContentControl}">
        <Grid>
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4" />
            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                    Background="{DynamicResource Yippy.Accent}" Visibility="Collapsed" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Yippy.SubtleHover}" />
            </Trigger>
            <Trigger Property="Selector.IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Yippy.SubtleSelected}" />
                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Yippy.ListItem}">
        <Setter Property="Template" Value="{StaticResource Yippy.ListItemTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource Yippy.SubtleHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Yippy.ListBoxItem" TargetType="ListBoxItem" BasedOn="{StaticResource Yippy.ListItem}">
        <Setter Property="Template" Value="{StaticResource Yippy.ListItemTemplate}" />
    </Style>

    <Style x:Key="Yippy.ListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Yippy.ListBoxItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Right-click menus -->
    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource Yippy.UIFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Yippy.PrimaryText}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Yippy.CardBackground}" BorderBrush="{DynamicResource Yippy.PanelBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="4">
                        <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="-4,4" Background="{DynamicResource Yippy.Divider}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Yippy.PrimaryText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="10,6" Margin="0,1" MinWidth="200">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIcon" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Icon" ContentSource="Icon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0" FontSize="12"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Yippy.SecondaryText}" />
                            <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;" FontFamily="{StaticResource Yippy.IconFont}" FontSize="10"
                                       Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                       Foreground="{DynamicResource Yippy.SecondaryText}" />
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="6" VerticalOffset="-5" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade" IsOpen="{TemplateBinding IsSubmenuOpen}">
                                <Border Background="{DynamicResource Yippy.CardBackground}" BorderBrush="{DynamicResource Yippy.PanelBorder}"
                                        BorderThickness="1" CornerRadius="8" Padding="4">
                                    <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Yippy.SubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Yippy.DisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource Yippy.UIFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Yippy.PrimaryText}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Yippy.CardBackground}" BorderBrush="{DynamicResource Yippy.PanelBorder}"
                            BorderThickness="1" CornerRadius="4" Padding="8,5,8,6" MaxWidth="320">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A key on the keyboard, for shortcut hints: the bottom edge is thicker, like a keycap -->
    <Style x:Key="Yippy.Keycap" TargetType="ContentControl">
        <Setter Property="FontFamily" Value="{StaticResource Yippy.UIFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Yippy.SecondaryText}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border MinWidth="20" Padding="5,1,5,2" CornerRadius="4" BorderThickness="1,1,1,2"
                            Background="{DynamicResource Yippy.KeycapBackground}" BorderBrush="{DynamicResource Yippy.KeycapBorder}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A shortcut as keycaps ("Ctrl+D" draws two keys), from presentation:KeyHint -->
    <Style TargetType="presentation:KeyHint">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="presentation:KeyHint">
                    <ItemsControl ItemsSource="{TemplateBinding Keycaps}" Focusable="False" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Style="{StaticResource Yippy.Keycap}" Content="{Binding}" Margin="0,0,3,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A settings row: what it is and what it does on the left, its control on the right (or below, for lists) -->
    <Style TargetType="presentation:SettingsCard">
        <Setter Property="Background" Value="{DynamicResource Yippy.CardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Yippy.CardBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Yippy.PrimaryText}" />
        <Setter Property="FontFamily" Value="{StaticResource Yippy.UIFont}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="presentation:SettingsCard">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Glyph}" FontFamily="{StaticResource Yippy.IconFont}" FontSize="20"
                                       Margin="2,0,18,0" VerticalAlignment="Center" Foreground="{DynamicResource Yippy.PrimaryText}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="{TemplateBinding Header}" FontSize="14" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Yippy.PrimaryText}" />
                                <TextBlock x:Name="Description" Text="{TemplateBinding Description}" FontSize="12" Margin="0,2,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource Yippy.SecondaryText}" />
                            </StackPanel>
                            <ContentPresenter x:Name="Control" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Glyph" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsContentBelow" Value="True">
                            <Setter TargetName="Control" Property="Grid.Row" Value="1" />
                            <Setter TargetName="Control" Property="Grid.Column" Value="1" />
                            <Setter TargetName="Control" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="Control" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="Control" Property="Margin" Value="0,12,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A message about the card above it, e.g. why a shortcut wasn't taken -->
    <Style x:Key="Yippy.InfoBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Yippy.CardSelected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Yippy.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- The navigation on the left of the settings window -->
    <Style x:Key="Yippy.NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource Yippy.ListBoxItem}">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,1" />
    </Style>
</ResourceDictionary>
