<!-- Cairn's light theme colours. ThemeManager swaps this dictionary when the Windows app theme changes.
     The accent is Ember 600, 5.6:1 on cards, so it can colour text and the focus of a control.
     Generated by brand/generate.py from brand/tokens.json. Edit the tokens, not this file. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="Yippy.PanelBackground" Color="#F3F0EB" />
    <SolidColorBrush x:Key="Yippy.PanelBorder" Color="#CFC8BE" />
    <SolidColorBrush x:Key="Yippy.CardBackground" Color="#FFFDFA" />
    <SolidColorBrush x:Key="Yippy.CardBorder" Color="#E2DDD5" />
    <SolidColorBrush x:Key="Yippy.CardHover" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Yippy.CardSelected" Color="#FBEDE6" />
    <SolidColorBrush x:Key="Yippy.Divider" Color="#E2DDD5" />

    <!-- Text -->
    <SolidColorBrush x:Key="Yippy.PrimaryText" Color="#1C1A18" />
    <SolidColorBrush x:Key="Yippy.SecondaryText" Color="#5E574F" />
    <SolidColorBrush x:Key="Yippy.DisabledText" Color="#A39B90" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Yippy.Accent" Color="#AD4722" />
    <SolidColorBrush x:Key="Yippy.AccentHover" Color="#9C4020" />
    <SolidColorBrush x:Key="Yippy.AccentPressed" Color="#8C391B" />
    <SolidColorBrush x:Key="Yippy.TextOnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Yippy.Link" Color="#AD4722" />

    <!-- Controls -->
    <SolidColorBrush x:Key="Yippy.ControlFill" Color="#FFFDFA" />
    <SolidColorBrush x:Key="Yippy.ControlFillHover" Color="#FAF8F5" />
    <SolidColorBrush x:Key="Yippy.ControlFillPressed" Color="#F3F0EB" />
    <SolidColorBrush x:Key="Yippy.ControlBorder" Color="#CFC8BE" />
    <SolidColorBrush x:Key="Yippy.SubtleHover" Color="#0F1C1A18" />
    <SolidColorBrush x:Key="Yippy.SubtlePressed" Color="#081C1A18" />
    <SolidColorBrush x:Key="Yippy.SubtleSelected" Color="#141C1A18" />
    <SolidColorBrush x:Key="Yippy.InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Yippy.InputBorder" Color="#CFC8BE" />
    <SolidColorBrush x:Key="Yippy.SegmentBackground" Color="#EBE7E1" />
    <SolidColorBrush x:Key="Yippy.SegmentSelected" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Yippy.ToggleOffBorder" Color="#7A7268" />
    <SolidColorBrush x:Key="Yippy.ScrollThumb" Color="#A39B90" />

    <!-- Keycaps: the panel's Ctrl+number hints and the shortcuts list -->
    <SolidColorBrush x:Key="Yippy.KeycapBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Yippy.KeycapBorder" Color="#CFC8BE" />

    <!-- Status -->
    <SolidColorBrush x:Key="Yippy.Favourite" Color="#C2334D" />
    <SolidColorBrush x:Key="Yippy.Danger" Color="#B3261E" />
    <SolidColorBrush x:Key="Yippy.Success" Color="#3D7A4C" />
</ResourceDictionary>
