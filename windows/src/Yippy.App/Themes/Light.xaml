<!-- The Light theme's colours. ThemeManager swaps this dictionary when the Windows app theme changes.
     The accent is the deep blue of Yippy's icon, darkened to 5.3:1 on white so it can be used for text. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="Yippy.PanelBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Yippy.PanelBorder" Color="#D1D1D1" />
    <SolidColorBrush x:Key="Yippy.CardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Yippy.CardBorder" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Yippy.CardHover" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Yippy.CardSelected" Color="#EEF5FB" />
    <SolidColorBrush x:Key="Yippy.Divider" Color="#E0E0E0" />

    <!-- Text -->
    <SolidColorBrush x:Key="Yippy.PrimaryText" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Yippy.SecondaryText" Color="#5E5E5E" />
    <SolidColorBrush x:Key="Yippy.DisabledText" Color="#A0A0A0" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Yippy.Accent" Color="#1A6FB3" />
    <SolidColorBrush x:Key="Yippy.AccentHover" Color="#2A7DC0" />
    <SolidColorBrush x:Key="Yippy.AccentPressed" Color="#3B88C6" />
    <SolidColorBrush x:Key="Yippy.TextOnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Yippy.Link" Color="#1A6FB3" />

    <!-- Controls -->
    <SolidColorBrush x:Key="Yippy.ControlFill" Color="#FBFBFB" />
    <SolidColorBrush x:Key="Yippy.ControlFillHover" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Yippy.ControlFillPressed" Color="#EDEDED" />
    <SolidColorBrush x:Key="Yippy.ControlBorder" Color="#D6D6D6" />
    <SolidColorBrush x:Key="Yippy.SubtleHover" Color="#0A000000" />
    <SolidColorBrush x:Key="Yippy.SubtlePressed" Color="#06000000" />
    <SolidColorBrush x:Key="Yippy.SubtleSelected" Color="#0F000000" />
    <SolidColorBrush x:Key="Yippy.InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Yippy.InputBorder" Color="#CFCFCF" />
    <SolidColorBrush x:Key="Yippy.SegmentBackground" Color="#E6E6E6" />
    <SolidColorBrush x:Key="Yippy.SegmentSelected" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Yippy.ToggleOffBorder" Color="#8A8A8A" />
    <SolidColorBrush x:Key="Yippy.ScrollThumb" Color="#B3B3B3" />

    <!-- Keycaps: the panel's Ctrl+number hints and the shortcuts list -->
    <SolidColorBrush x:Key="Yippy.KeycapBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Yippy.KeycapBorder" Color="#C8C8C8" />

    <!-- Status -->
    <SolidColorBrush x:Key="Yippy.Favourite" Color="#C42B3C" />
    <SolidColorBrush x:Key="Yippy.Danger" Color="#C42B1C" />
    <SolidColorBrush x:Key="Yippy.Success" Color="#0F7B0F" />
</ResourceDictionary>
