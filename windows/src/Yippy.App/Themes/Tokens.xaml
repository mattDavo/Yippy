<!-- Cairn's shape, spacing and type size tokens, shared by both themes. Fluent.xaml and the views use these keys.
     Generated by brand/generate.py from brand/tokens.json. Edit the tokens, not this file. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Corner radii: Small for keycaps and swatches, Control for buttons and inputs, Card for cards and
         segments, Overlay for menus and flyouts, Window for the panel -->
    <CornerRadius x:Key="Yippy.Radius.Small">4</CornerRadius>
    <sys:Double x:Key="Yippy.RadiusValue.Small">4</sys:Double>
    <CornerRadius x:Key="Yippy.Radius.Control">6</CornerRadius>
    <sys:Double x:Key="Yippy.RadiusValue.Control">6</sys:Double>
    <CornerRadius x:Key="Yippy.Radius.Card">10</CornerRadius>
    <sys:Double x:Key="Yippy.RadiusValue.Card">10</sys:Double>
    <CornerRadius x:Key="Yippy.Radius.Overlay">12</CornerRadius>
    <sys:Double x:Key="Yippy.RadiusValue.Overlay">12</sys:Double>
    <CornerRadius x:Key="Yippy.Radius.Window">14</CornerRadius>
    <sys:Double x:Key="Yippy.RadiusValue.Window">14</sys:Double>

    <!-- Spacing: a 4 px scale -->
    <sys:Double x:Key="Yippy.Space.XXS">2</sys:Double>
    <sys:Double x:Key="Yippy.Space.XS">4</sys:Double>
    <sys:Double x:Key="Yippy.Space.S">8</sys:Double>
    <sys:Double x:Key="Yippy.Space.M">12</sys:Double>
    <sys:Double x:Key="Yippy.Space.L">16</sys:Double>
    <sys:Double x:Key="Yippy.Space.XL">24</sys:Double>
    <sys:Double x:Key="Yippy.Space.XXL">32</sys:Double>

    <!-- Type sizes (Fluent.xaml pairs them with weights and fonts) -->
    <sys:Double x:Key="Yippy.FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="Yippy.FontSize.Body">14</sys:Double>
    <sys:Double x:Key="Yippy.FontSize.BodyStrong">14</sys:Double>
    <sys:Double x:Key="Yippy.FontSize.Subtitle">20</sys:Double>
    <sys:Double x:Key="Yippy.FontSize.Title">28</sys:Double>
    <sys:Double x:Key="Yippy.FontSize.Mono">12</sys:Double>
</ResourceDictionary>
