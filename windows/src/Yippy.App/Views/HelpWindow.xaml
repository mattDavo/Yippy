<Window x:Class="Yippy.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yippy Help"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Yippy;component/Assets/Yippy.ico">
    <StackPanel Margin="20">
        <TextBlock Text="Yippy keeps everything you copy. Open it, pick an item and it's pasted where you were typing."
                   TextWrapping="Wrap" Margin="0,0,0,14" />
        <ItemsControl x:Name="Shortcuts">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Keys}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Action}" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Foreground="Gray">
            Search filters: /img, /link, /file and /color show one kind of item; @name shows items copied in that app.
            Drag an item onto another to move it. Right-click an item for more.
        </TextBlock>
    </StackPanel>
</Window>
