<Window x:Class="Yippy.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:Yippy.App.Presentation"
        Title="Yippy Keyboard Shortcuts"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Yippy.PanelBackground}"
        Foreground="{DynamicResource Yippy.PrimaryText}"
        FontFamily="{StaticResource Yippy.UIFont}"
        UseLayoutRounding="True"
        presentation:WindowStyling.FollowsTheme="True"
        Icon="pack://application:,,,/Yippy;component/Assets/Yippy.ico">
    <StackPanel Margin="24,20,24,24">
        <TextBlock Text="Keyboard shortcuts" Style="{StaticResource Yippy.SubtitleText}" />
        <TextBlock Text="Open Yippy, pick an item, and it's pasted where you were typing."
                   Style="{StaticResource Yippy.CaptionText}" FontSize="14" Margin="0,4,0,16" />
        <Border Background="{DynamicResource Yippy.CardBackground}" BorderBrush="{DynamicResource Yippy.CardBorder}"
                BorderThickness="1" CornerRadius="6" Padding="16,8">
            <ItemsControl x:Name="Shortcuts" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl ItemsSource="{Binding Keys}" Focusable="False" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <presentation:KeyHint Keys="{Binding}" Margin="0,1,6,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Column="1" Text="{Binding Action}" Style="{StaticResource Yippy.BodyText}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <TextBlock Style="{StaticResource Yippy.CaptionText}" Margin="2,14,0,0">
            Search filters: /img, /link, /file and /color show one kind of item, and @name shows what was copied in that app.
            Drag an item onto another to move it. Right-click an item for more.
        </TextBlock>
    </StackPanel>
</Window>
