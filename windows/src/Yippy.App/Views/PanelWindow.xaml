<Window x:Class="Yippy.App.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Yippy.App.ViewModels"
        xmlns:presentation="clr-namespace:Yippy.App.Presentation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PanelViewModel}"
        Title="Cairn"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Yippy.PanelBackground}"
        Foreground="{DynamicResource Yippy.PrimaryText}"
        FontFamily="{StaticResource Yippy.UIFont}"
        UseLayoutRounding="True"
        presentation:WindowStyling.FollowsTheme="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <!-- A card per item. The selected one is tinted, with an accent border and a pill on its left edge (no layout shift) -->
        <Style x:Key="ItemContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="10,0,10,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Card" Background="{DynamicResource Yippy.CardBackground}"
                                    BorderBrush="{DynamicResource Yippy.CardBorder}" BorderThickness="1" CornerRadius="{StaticResource Yippy.Radius.Card}">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Pill" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Margin="3,0,0,0" Background="{DynamicResource Yippy.Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Yippy.CardHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Yippy.CardSelected}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Yippy.Accent}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnItemMouseDown" />
            <EventSetter Event="PreviewMouseMove" Handler="OnItemMouseMove" />
            <EventSetter Event="Drop" Handler="OnItemDrop" />
            <EventSetter Event="DragOver" Handler="OnItemDragOver" />
        </Style>

        <ContextMenu x:Key="ItemMenu" x:Shared="False">
            <MenuItem Header="Paste" InputGestureText="Enter"
                      Command="{Binding Panel.PasteCommand}" CommandParameter="{Binding}" />
            <MenuItem Header="Paste as Plain Text" InputGestureText="Shift+Enter"
                      Command="{Binding Panel.PastePlainTextCommand}" CommandParameter="{Binding}"
                      Visibility="{Binding HasText, Converter={StaticResource VisibleWhen}}" />
            <MenuItem Header="Paste Transformed" ItemsSource="{Binding Transforms}"
                      Visibility="{Binding HasText, Converter={StaticResource VisibleWhen}}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Title}" />
                        <Setter Property="IsEnabled" Value="{Binding IsApplicable}" />
                        <Setter Property="Command" Value="{Binding Item.Panel.PasteTransformedCommand}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <Separator />
            <MenuItem Header="{Binding FavouriteMenuTitle}" InputGestureText="Ctrl+D"
                      Command="{Binding Panel.ToggleFavouriteCommand}" CommandParameter="{Binding}" />
            <MenuItem Header="Rename…" Command="{Binding Panel.RenameCommand}" CommandParameter="{Binding}"
                      Visibility="{Binding CanRename, Converter={StaticResource VisibleWhen}}" />
            <MenuItem Header="Edit…" Command="{Binding Panel.EditCommand}" CommandParameter="{Binding}"
                      Visibility="{Binding CanEdit, Converter={StaticResource VisibleWhen}}" />
            <MenuItem Header="{Binding ShowFromAppTitle}" Command="{Binding Panel.ShowItemsFromAppCommand}" CommandParameter="{Binding}"
                      Visibility="{Binding HasSource, Converter={StaticResource VisibleWhen}}" />
            <Separator />
            <MenuItem Header="Delete" InputGestureText="Ctrl+Delete"
                      Command="{Binding Panel.DeleteCommand}" CommandParameter="{Binding}" />
        </ContextMenu>

        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type vm:ItemViewModel}">
            <Grid ContextMenu="{StaticResource ItemMenu}" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplateSelector="{StaticResource Yippy.ItemContentSelector}"
                                  Margin="12,10,12,6" MaxHeight="200" ClipToBounds="True" />
                <!-- Info bar: source app icon, name, source app and time, Ctrl+number keycap, heart -->
                <Grid Grid.Row="1" Margin="12,0,6,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding SourceIcon}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
                           Visibility="{Binding SourceIcon, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="{StaticResource Yippy.FontSize.Caption}"
                               ToolTip="{Binding CopiedAtToolTip}">
                        <!-- No whitespace between the runs, or an item without a name starts with a space -->
                        <Run Text="{Binding Title, Mode=OneWay, StringFormat='{}{0}  '}" FontWeight="SemiBold" Foreground="{DynamicResource Yippy.PrimaryText}"
                        /><Run Text="{Binding InfoText, Mode=OneWay}" Foreground="{DynamicResource Yippy.SecondaryText}" />
                    </TextBlock>
                    <ContentControl Grid.Column="2" Style="{StaticResource Yippy.Keycap}" Content="{Binding ShortcutKey}" Margin="8,0,2,0"
                                    ToolTip="{Binding ShortcutToolTip}"
                                    Visibility="{Binding ShortcutKey, Converter={StaticResource VisibleWhen}}" />
                    <Button x:Name="Heart" Grid.Column="3" Style="{StaticResource Yippy.IconButton}" Content="{Binding FavouriteGlyph}"
                            ToolTip="{Binding FavouriteToolTip}"
                            Command="{Binding Panel.ToggleFavouriteCommand}" CommandParameter="{Binding}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Yippy.Favourite}" TargetName="Heart" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- Windows 11 draws the border itself (WindowStyling), around rounded corners -->
    <Border BorderBrush="{DynamicResource Yippy.PanelBorder}" BorderThickness="{DynamicResource Yippy.FrameThickness}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Clipboard / Favourites, the item count, help and settings -->
            <Grid Margin="10,10,6,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Yippy.SegmentBackground}" CornerRadius="{StaticResource Yippy.Radius.Card}" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Yippy.SegmentButton}" Content="Clipboard" GroupName="Group"
                                     IsChecked="{Binding IsClipboardSelected}" ToolTip="Ctrl+Tab switches" />
                        <RadioButton Style="{StaticResource Yippy.SegmentButton}" Content="{Binding FavouritesTitle}" GroupName="Group"
                                     IsChecked="{Binding IsFavouritesSelected}" ToolTip="Ctrl+Tab switches" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding CountText}" Margin="12,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="{StaticResource Yippy.FontSize.Caption}" Foreground="{DynamicResource Yippy.SecondaryText}" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Style="{StaticResource Yippy.IconButton}" Content="&#xE897;" ToolTip="Keyboard shortcuts"
                        AutomationProperties.Name="Keyboard shortcuts" Command="{Binding ShowHelpCommand}" />
                <Button Grid.Column="3" Style="{StaticResource Yippy.IconButton}" Content="&#xE713;" ToolTip="Settings"
                        AutomationProperties.Name="Settings" Command="{Binding OpenSettingsCommand}" />
            </Grid>

            <TextBox x:Name="SearchBox" Grid.Row="1" Margin="10,0,10,10" Style="{StaticResource Yippy.SearchBox}"
                     Tag="{Binding SearchPlaceholder}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search" />

            <ListBox x:Name="ItemList" Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                     ItemContainerStyle="{StaticResource ItemContainer}" ItemTemplate="{StaticResource ItemTemplate}"
                     Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" AllowDrop="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" SelectionChanged="OnSelectionChanged"
                     AutomationProperties.Name="{Binding CountText}" />

            <!-- Nothing to show: say why, and what to do -->
            <StackPanel Grid.Row="2" Margin="32,40,32,24" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="300"
                        Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="{Binding EmptyGlyph}" FontFamily="{StaticResource Yippy.IconFont}" FontSize="32"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Yippy.SecondaryText}" />
                <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource Yippy.BodyStrongText}" TextAlignment="Center"
                           Margin="0,14,0,4" />
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Yippy.CaptionText}" TextAlignment="Center" />
            </StackPanel>

            <!-- What the keyboard does, at a glance -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource Yippy.Divider}" BorderThickness="0,1,0,0" Padding="12,8,12,9">
                <WrapPanel>
                    <WrapPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{StaticResource Yippy.FontSize.Caption}" />
                            <Setter Property="Foreground" Value="{DynamicResource Yippy.SecondaryText}" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="2,0,14,0" />
                        </Style>
                    </WrapPanel.Resources>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <presentation:KeyHint Keys="Enter" />
                        <TextBlock Text="Paste" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <presentation:KeyHint Keys="Shift+Enter" />
                        <TextBlock Text="Plain text" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <presentation:KeyHint Keys="Ctrl+D" />
                        <TextBlock Text="Favourite" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <presentation:KeyHint Keys="Ctrl+Space" />
                        <TextBlock Text="Preview" />
                    </StackPanel>
                </WrapPanel>
            </Border>
        </Grid>
    </Border>
</Window>
