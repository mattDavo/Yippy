<Window x:Class="Yippy.App.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Yippy.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PanelViewModel}"
        Title="Yippy"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Yippy.PanelBackground}"
        Foreground="{DynamicResource Yippy.PrimaryText}"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <!-- A card per item; the selected one gets an accent border -->
        <Style x:Key="ItemContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="8,0,8,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{DynamicResource Yippy.CardBackground}"
                                BorderBrush="{DynamicResource Yippy.CardBorder}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Yippy.CardHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Yippy.Accent}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnItemMouseDown" />
            <EventSetter Event="PreviewMouseMove" Handler="OnItemMouseMove" />
            <EventSetter Event="Drop" Handler="OnItemDrop" />
            <EventSetter Event="DragOver" Handler="OnItemDragOver" />
        </Style>

        <ContextMenu x:Key="ItemMenu" x:Shared="False">
            <MenuItem Header="Paste" InputGestureText="Enter"
                      Command="{Binding Panel.PasteCommand}" CommandParameter="{Binding}" />
            <MenuItem Header="Paste as Plain Text" InputGestureText="Shift+Enter"
                      Command="{Binding Panel.PastePlainTextCommand}" CommandParameter="{Binding}"
                      Visibility="{Binding HasText, Converter={StaticResource VisibleWhen}}" />
            <MenuItem Header="Paste Transformed" ItemsSource="{Binding Transforms}"
                      Visibility="{Binding HasText, Converter={StaticResource VisibleWhen}}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Title}" />
                        <Setter Property="IsEnabled" Value="{Binding IsApplicable}" />
                        <Setter Property="Command" Value="{Binding Item.Panel.PasteTransformedCommand}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <Separator />
            <MenuItem Header="{Binding FavouriteMenuTitle}" InputGestureText="Ctrl+D"
                      Command="{Binding Panel.ToggleFavouriteCommand}" CommandParameter="{Binding}" />
            <MenuItem Header="Rename…" Command="{Binding Panel.RenameCommand}" CommandParameter="{Binding}"
                      Visibility="{Binding CanRename, Converter={StaticResource VisibleWhen}}" />
            <MenuItem Header="Edit…" Command="{Binding Panel.EditCommand}" CommandParameter="{Binding}"
                      Visibility="{Binding CanEdit, Converter={StaticResource VisibleWhen}}" />
            <MenuItem Header="{Binding ShowFromAppTitle}" Command="{Binding Panel.ShowItemsFromAppCommand}" CommandParameter="{Binding}"
                      Visibility="{Binding HasSource, Converter={StaticResource VisibleWhen}}" />
            <Separator />
            <MenuItem Header="Delete" InputGestureText="Ctrl+Delete"
                      Command="{Binding Panel.DeleteCommand}" CommandParameter="{Binding}" />
        </ContextMenu>

        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type vm:ItemViewModel}">
            <Grid ContextMenu="{StaticResource ItemMenu}" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplateSelector="{StaticResource Yippy.ItemContentSelector}"
                                  Margin="10,8,10,4" MaxHeight="200" ClipToBounds="True" />
                <!-- Info bar: name, source app and time, shortcut, heart -->
                <Grid Grid.Row="1" Margin="10,0,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding SourceIcon}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
                           Visibility="{Binding SourceIcon, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11"
                               ToolTip="{Binding CopiedAtToolTip}">
                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Yippy.PrimaryText}" />
                        <Run Text="{Binding InfoText, Mode=OneWay}" Foreground="{DynamicResource Yippy.SecondaryText}" />
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding ShortcutText}" FontSize="11" Margin="8,0,2,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Yippy.SecondaryText}" />
                    <Button x:Name="Heart" Grid.Column="3" Style="{StaticResource Yippy.IconButton}" Content="{Binding FavouriteGlyph}"
                            ToolTip="{Binding FavouriteToolTip}"
                            Command="{Binding Panel.ToggleFavouriteCommand}" CommandParameter="{Binding}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Yippy.Favourite}" TargetName="Heart" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Yippy.PanelBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Clipboard / Favourites, and the item count -->
            <Grid Margin="8,8,8,6">
                <Border Background="{DynamicResource Yippy.SegmentBackground}" CornerRadius="6" Padding="2" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Yippy.SegmentButton}" Content="Clipboard" GroupName="Group"
                                     IsChecked="{Binding IsClipboardSelected}" ToolTip="Ctrl+Tab switches" />
                        <RadioButton Style="{StaticResource Yippy.SegmentButton}" Content="{Binding FavouritesTitle}" GroupName="Group"
                                     IsChecked="{Binding IsFavouritesSelected}" ToolTip="Ctrl+Tab switches" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding CountText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource Yippy.SecondaryText}" />
            </Grid>

            <TextBox x:Name="SearchBox" Grid.Row="1" Margin="8,0,8,8" Style="{StaticResource Yippy.SearchBox}"
                     Tag="{Binding SearchPlaceholder}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <ListBox x:Name="ItemList" Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                     ItemContainerStyle="{StaticResource ItemContainer}" ItemTemplate="{StaticResource ItemTemplate}"
                     Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" AllowDrop="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" SelectionChanged="OnSelectionChanged">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource Yippy.ScrollBar}" />
                </ListBox.Resources>
            </ListBox>

            <TextBlock Grid.Row="2" Text="{Binding EmptyText}" Margin="24" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="{DynamicResource Yippy.SecondaryText}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" />
        </Grid>
    </Border>
</Window>
