<Window x:Class="Yippy.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:Yippy.App.Presentation"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{DynamicResource Yippy.PanelBackground}"
        Foreground="{DynamicResource Yippy.PrimaryText}"
        FontFamily="{StaticResource Yippy.UIFont}"
        UseLayoutRounding="True"
        presentation:WindowStyling.FollowsTheme="True">
    <!-- Asks for a name or a text, for renaming and editing favourites -->
    <StackPanel Margin="24,20,24,24">
        <TextBlock x:Name="MessageText" Style="{StaticResource Yippy.BodyText}" Margin="0,0,0,12" />
        <TextBox x:Name="Input" Style="{StaticResource Yippy.TextBox}" VerticalContentAlignment="Top" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource Yippy.AccentButton}" Content="Save" IsDefault="True" MinWidth="96" Margin="0,0,8,0" Click="OnSave" />
            <Button Style="{StaticResource Yippy.Button}" Content="Cancel" IsCancel="True" MinWidth="96" />
        </StackPanel>
    </StackPanel>
</Window>
