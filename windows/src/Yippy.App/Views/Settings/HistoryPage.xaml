<UserControl x:Class="Yippy.App.Views.Settings.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:Yippy.App.ViewModels.Settings"
             xmlns:views="clr-namespace:Yippy.App.Views"
             xmlns:presentation="clr-namespace:Yippy.App.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=settings:HistoryPageViewModel}">
    <StackPanel>
        <presentation:SettingsCard Glyph="&#xE8F1;" Header="Items to keep"
                                   Description="When there are more, the oldest are deleted. Favourites don't count.">
            <ComboBox MinWidth="140" ItemsSource="{Binding MaxHistoryOptions}" SelectedItem="{Binding MaxHistory}"
                      AutomationProperties.Name="Items to keep" />
        </presentation:SettingsCard>
        <presentation:SettingsCard Glyph="&#xE787;" Header="Delete old items"
                                   Description="Items are deleted once they're this old. Favourites are never deleted automatically.">
            <ComboBox MinWidth="180" ItemsSource="{Binding MaxAgeOptions}" DisplayMemberPath="Title" SelectedValuePath="Value"
                      SelectedValue="{Binding MaxItemAgeDays}" AutomationProperties.Name="Delete old items" />
        </presentation:SettingsCard>
        <presentation:SettingsCard Glyph="&#xE916;" Header="Apps whose copies expire" IsContentBelow="True"
                                   Description="Anything copied from these apps is deleted after a minute and cleared from the clipboard, for example a terminal or a remote desktop.">
            <views:AppListEditor DataContext="{Binding ExpiringApps}" />
        </presentation:SettingsCard>

        <TextBlock Text="Start over" Style="{StaticResource Yippy.SectionHeader}" />
        <presentation:SettingsCard Glyph="&#xE74D;" Header="Clear history" Description="{Binding ItemCountText}">
            <Button Style="{StaticResource Yippy.DangerButton}" Content="Clear history…" Command="{Binding ClearHistoryCommand}" />
        </presentation:SettingsCard>
    </StackPanel>
</UserControl>
