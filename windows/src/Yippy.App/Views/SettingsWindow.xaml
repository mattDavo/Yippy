<Window x:Class="Yippy.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:settings="clr-namespace:Yippy.App.ViewModels.Settings"
        xmlns:pages="clr-namespace:Yippy.App.Views.Settings"
        xmlns:presentation="clr-namespace:Yippy.App.Presentation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=settings:SettingsViewModel}"
        Title="Cairn Settings"
        Width="900"
        Height="660"
        MinWidth="700"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Yippy.PanelBackground}"
        Foreground="{DynamicResource Yippy.PrimaryText}"
        FontFamily="{StaticResource Yippy.UIFont}"
        UseLayoutRounding="True"
        presentation:WindowStyling.FollowsTheme="True"
        Icon="pack://application:,,,/Cairn;component/Assets/AppIcon.ico">
    <!-- Navigation on the left, the selected page on the right. Every change is saved straight away. -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type settings:GeneralPageViewModel}">
            <pages:GeneralPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:ShortcutPageViewModel}">
            <pages:ShortcutPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:HistoryPageViewModel}">
            <pages:HistoryPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:PrivacyPageViewModel}">
            <pages:PrivacyPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:SyncPageViewModel}">
            <pages:SyncPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:AboutPageViewModel}">
            <pages:AboutPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="12,16,8,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,20">
                <Image Source="pack://application:,,,/Cairn;component/Assets/AppIcon.ico" Width="28" Height="28"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Cairn" Style="{StaticResource Yippy.BodyStrongText}" />
                    <TextBlock Text="Settings" Style="{StaticResource Yippy.CaptionText}" />
                </StackPanel>
            </StackPanel>
            <ListBox Style="{StaticResource Yippy.ListBox}" ItemContainerStyle="{StaticResource Yippy.NavItem}"
                     ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                     AutomationProperties.Name="Settings pages">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type settings:SettingsPageViewModel}">
                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Title}">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Yippy.IconFont}" FontSize="16"
                                       Margin="4,0,14,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" FontSize="{StaticResource Yippy.FontSize.Body}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24,12,36,36" MaxWidth="880">
                <TextBlock Text="{Binding SelectedPage.Title}" Style="{StaticResource Yippy.TitleText}" Margin="0,0,0,20" />
                <ContentControl Content="{Binding SelectedPage}" Focusable="False" IsTabStop="False" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
