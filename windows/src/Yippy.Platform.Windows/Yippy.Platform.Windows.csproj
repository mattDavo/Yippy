<Project Sdk="Microsoft.NET.Sdk">
  <!-- Win32 and WinRT adapters: clipboard, hot keys, focus and paste, OCR, start-up registration. -->
  <PropertyGroup>
    <TargetFramework>$(YippyWindowsTargetFramework)</TargetFramework>
    <RootNamespace>Yippy.Platform.Windows</RootNamespace>
    <UseWPF>true</UseWPF>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Win+V scripts, so Settings can save copies of them (EmbeddedClipboardShortcutScripts). -->
    <EmbeddedResource Include="..\..\scripts\*.ps1" LogicalName="Yippy.Scripts.%(Filename)%(Extension)" Link="Scripts\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- DPAPI, to keep the sync key encrypted for the user (DpapiSyncKeyStore). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Yippy.UseCases\Yippy.UseCases.csproj" />
  </ItemGroup>
</Project>
